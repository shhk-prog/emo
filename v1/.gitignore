# Environments
.env
.venv/
env/
venv/
ENV/

# Python cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/

# Data and Results
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
results/raw/*
!results/raw/.gitkeep
